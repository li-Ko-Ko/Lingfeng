# Public source allowlist. Personal scores, recordings and local notes stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/LICENSE
!/main.py
!/build.ps1
!/requirements.txt
!/requirements-build.txt
!/launch.cmd
!/start.ps1
!/popscore/
!/scripts/
!/tests/
!/docs/
!/assets/
!/native/
!/examples/
!/licenses/
!/synths/

/licenses/sfizz-1.2.3/
/licenses/sfz-sources/
/synths/*
!/synths/stk-essentials/
!/synths/stk-colors/
!/synths/stk-acoustic/

**/__pycache__/
*.py[cod]
*.spec
*.tmp
*.log
.env
.env.*
preferences.json
preferences.json.*
recovery.popscore
