# Public source allowlist. Personal scores, recordings and local notes stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/LICENSE
!/main.py
!/build.ps1
!/requirements.txt
!/requirements-build.txt
!/launch.cmd
!/start.ps1
!/lingfeng/
!/scripts/
!/tests/
!/docs/
!/assets/
!/native/
!/examples/
!/licenses/
!/synths/

# Public reproduction inputs only; keep local design/maintenance material local.
/docs/*
!/docs/HELP.md
!/docs/FORMAT.md
!/docs/SOUNDBANKS.md
!/docs/PROGRESSIONS.md
!/docs/REFERENCES.md
!/docs/THIRD_PARTY.md
!/docs/LICENSE_AUDIT.md
/scripts/*
!/scripts/audit_text.py
!/scripts/build_synth_packs.py
!/scripts/collect_qt_notices.py
!/scripts/export_help.py
!/scripts/make_icon.py
!/scripts/package_release.py
!/scripts/release_policy.py
!/scripts/run_regression.py
!/scripts/verify_audio.py
!/scripts/verify_release.py
/tests/legacy/
/tests/test_architecture.py
/examples/*.popscore

/licenses/sfizz-1.2.3/
/licenses/sfz-sources/
/synths/*
!/synths/stk-essentials/
!/synths/stk-colors/
!/synths/stk-acoustic/

**/__pycache__/
*.py[cod]
*.spec
*.tmp
*.log
.env
.env.*
preferences.json
preferences.json.*
recovery.popscore
recovery.lfs
